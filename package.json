{
  "name": "dionis-store",
  "private": true,
  "prettier": "@repo/prettier-config",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:e2e:local": "pnpm --filter @repo/e2e test:e2e:local",
    "e2e:down": "pnpm --filter @repo/e2e e2e:down",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "dev:api": "turbo dev --filter api",
    "dev:web": "turbo dev --filter web",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "prettier": "^3.2.5",
    "turbo": "latest"
  },
  "packageManager": "pnpm@8.9.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.3.0",
      "lodash": "^4.18.0",
      "jws": "^3.2.3",
      "proxy-addr": "^2.0.8",
      "form-data": "^4.0.6",
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "validator": "^13.15.35",
      "glob@10": "^10.5.0",
      "js-yaml@3": "^3.14.2",
      "js-yaml@4": "^4.1.1",
      "sha.js": "^2.4.12",
      "cipher-base": "^1.0.5",
      "pbkdf2": "^3.1.3",
      "tmp@<0.2.4": "^0.2.4",
      "brace-expansion@2": "^2.0.2",
      "formidable": "^3.5.3",
      "@babel/helpers": "^7.26.10",
      "jsonpath-plus@<10.3.0": "^10.3.0",
      "elliptic": "^6.6.1",
      "esbuild@<0.25.0": "^0.25.0",
      "nanoid@3": "^3.3.8",
      "cross-spawn@7": "^7.0.5",
      "cookie@<0.7.0": "^0.7.0"
    }
  }
}
