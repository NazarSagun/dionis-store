# Reverse proxy for the single-host deployment (docker-compose.prod.yml). It
# serves https://{$DOMAIN}, gets and renews the Let's Encrypt certificate by
# itself, and redirects HTTP to HTTPS. The API already uses the /api prefix, so
# one origin carries both apps and the browser needs no CORS.
{
	# Set ACME_CA to the Let's Encrypt staging address for a first test run.
	# Staging has no rate limit for failed attempts, but its certificate is not trusted.
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

{$DOMAIN} {
	encode gzip

	# Browser-side protections for every response. No includeSubDomains in HSTS:
	# the mail subdomains point at a mail provider, not at this server.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		# allow-popups keeps window.open() popups (for example a 3-D Secure window) working.
		Cross-Origin-Opener-Policy same-origin-allow-popups
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Report-only: the browser logs violations in the console and blocks
		# nothing. Run a full purchase, then rename the header to
		# Content-Security-Policy to enforce it. 'unsafe-inline' is for the
		# inline scripts and styles Next.js writes. Remove it only after adding nonces.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.freetogame.com https://*.stripe.com; connect-src 'self' https://api.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'"
		-Server
		-X-Powered-By
	}

	# One JSON line per request on stdout, so the container log (and Alloy,
	# which ships it to Grafana) shows traffic. The app itself logs no requests.
	# Request and response headers are dropped: they hold cookies and tokens.
	# The query string is dropped too: Stripe's return URL carries payment
	# parameters in it.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp "\?.*" ""
			}
		}
	}

	# Skip static files: the web app serves dozens per page view, and they say
	# nothing about what users do.
	@static path /_next/static/* /images/* /favicon.ico
	log_skip @static

	handle /api/* {
		reverse_proxy api:3500
	}

	handle {
		reverse_proxy web:3000
	}
}
