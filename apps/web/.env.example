NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sentry error reporting for the web app (project dionis-web). Empty turns it off.
# Inlined into the browser bundle at build time.
NEXT_PUBLIC_SENTRY_DSN=
# Uploads source maps to Sentry on `next build`. Secret. Empty skips the upload.
SENTRY_AUTH_TOKEN=
