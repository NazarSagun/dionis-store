DATABASE_URL=
ACCESS_TOKEN=
REFRESH_TOKEN=

PORT=
# Web app origin(s) allowed by CORS. Comma-separated for more than one.
CLIENT_URL=http://localhost:3000

# Stripe test-mode secret key (dashboard.stripe.com/test/apikeys). Test mode only.
STRIPE_SECRET_KEY=

# Signing secret for POST /api/orders/webhook. Locally, `stripe listen` prints it
# (whsec_...). Leave empty to run without the webhook: the API still starts.
STRIPE_WEBHOOK_SECRET=

# Set to false when the API is served over plain HTTP (no HTTPS yet). Browsers
# drop a Secure cookie from an HTTP origin, so with the default (true) the
# refresh cookie is lost and the user is logged out on every page load.
# Leave it unset on localhost and on any HTTPS deployment.
COOKIE_SECURE=

# Rate limiting. The API allows 300 requests a minute per client IP, and 10 a
# minute on login, register, and password change. Set RATE_LIMIT=off to turn it
# off (the E2E run does, because its tests sign up many users from one address).
RATE_LIMIT=
# Number of reverse proxies in front of the API: 1 behind Caddy, 0 otherwise.
# Without it every request looks like it comes from the proxy, and one user's
# traffic counts against everyone.
TRUST_PROXY=

# Receipt emails, sent through SMTP. Locally and in CI this is Mailpit
# (`docker compose up mailpit` in apps/api; inbox at http://localhost:8025).
# Leave SMTP_HOST empty to run without email: the API still starts and sends
# nothing. SMTP_USER and SMTP_PASS stay empty for Mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dionis Store <no-reply@dionis-store.local>

# Used by `pnpm seed:api` (src/seed/populate-via-api.ts) to seed games through
# the real, running API. Defaults are fine for local use.
SEED_API_URL=http://localhost:3500/api
SEED_ADMIN_NAME=Seed Admin
SEED_ADMIN_EMAIL=seed-admin@dionis-store.local
# Required. Local default only: use a long random value on a public deployment.
SEED_ADMIN_PASSWORD=seed-admin-password