// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  password     String
  refreshToken String?  @unique
  previousRefreshToken   String?   @unique
  previousRefreshTokenAt DateTime?
  role         Int      @default(101)
  createdAt    DateTime @default(now())
  orders       Order[]
  wishlist     WishlistItem[]
  reviews      Review[]
  replies       ReviewReply[]
  notifications Notification[]
}

model Game_pc {
  id                     Int           @id @default(autoincrement())
  title                  String        @unique
  thumbnail              String
  short_description      String
  genre                  String
  platform               String
  publisher              String
  developer              String
  release_date           String
  price                  Int
  rating                 String
  discount               Int
  orderItems             OrderItem[]
  editions               GameEdition[]
  wishlistItems          WishlistItem[]
  reviews                Review[]
}

model GameEdition {
  id          Int         @id @default(autoincrement())
  gameId      Int
  game        Game_pc     @relation(fields: [gameId], references: [id])
  name        String
  price       Int
  discount    Int         @default(0)
  stock       Int
  description String
  orderItems  OrderItem[]
}

model Order {
  id                    Int         @id @default(autoincrement())
  userId                Int
  user                  User        @relation(fields: [userId], references: [id])
  totalPrice            Int
  stripePaymentIntentId String      @unique
  shippingName          String?
  shippingLine1         String?
  shippingLine2         String?
  shippingCity          String?
  shippingPostalCode    String?
  shippingCountry       String?
  // Set when the receipt email is claimed. Null means no email went out, so a
  // later job can retry it.
  receiptSentAt         DateTime?
  createdAt             DateTime    @default(now())
  items                 OrderItem[]
}

model OrderItem {
  id             Int          @id @default(autoincrement())
  orderId        Int
  order          Order        @relation(fields: [orderId], references: [id])
  gameId         Int
  game           Game_pc      @relation(fields: [gameId], references: [id])
  editionId      Int?
  edition        GameEdition? @relation(fields: [editionId], references: [id])
  quantity       Int
  price          Int
  activationCode String?
  activated      Boolean      @default(false)
  activatedAt    DateTime?
}

// discountSnapshot is the game's discount when it was added, or when the
// "Price dropped" badge last showed. The badge compares it to the current
// discount.
model WishlistItem {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId           Int
  game             Game_pc  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  discountSnapshot Int
  createdAt        DateTime @default(now())

  @@unique([userId, gameId])
}

// One review per user and game. Only a user who bought the game can write it.
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    Int
  game      Game_pc  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  rating    Int
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies   ReviewReply[]

  @@unique([userId, gameId])
  @@index([gameId, createdAt])
}

// A flat thread under a review. Only a user who bought the game can reply.
model ReviewReply {
  id            Int            @id @default(autoincrement())
  reviewId      Int
  review        Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime       @default(now())
  notifications Notification[]

  @@index([reviewId, createdAt])
}

// One row per recipient and reply. A row with a readAt date no longer shows in
// the bell.
model Notification {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyId   Int
  reply     ReviewReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime    @default(now())

  @@unique([userId, replyId])
  @@index([userId, readAt])
}
