// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  password     String
  refreshToken String?  @unique
  role         Int      @default(101)
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Game_pc {
  id                     Int           @id
  title                  String        @unique
  thumbnail              String
  short_description      String
  game_url               String
  genre                  String
  platform               String
  publisher              String
  developer              String
  release_date           String
  freetogame_profile_url String
  price                  Int
  rating                 String
  discount               Int
  orderItems             OrderItem[]
  editions               GameEdition[]
}

model GameEdition {
  id          Int         @id @default(autoincrement())
  gameId      Int
  game        Game_pc     @relation(fields: [gameId], references: [id])
  name        String
  price       Int
  discount    Int         @default(0)
  stock       Int
  description String
  orderItems  OrderItem[]
}

model Order {
  id                    Int         @id @default(autoincrement())
  userId                Int
  user                  User        @relation(fields: [userId], references: [id])
  totalPrice            Int
  stripePaymentIntentId String      @unique
  shippingName          String?
  shippingLine1         String?
  shippingLine2         String?
  shippingCity          String?
  shippingPostalCode    String?
  shippingCountry       String?
  createdAt             DateTime    @default(now())
  items                 OrderItem[]
}

model OrderItem {
  id             Int          @id @default(autoincrement())
  orderId        Int
  order          Order        @relation(fields: [orderId], references: [id])
  gameId         Int
  game           Game_pc      @relation(fields: [gameId], references: [id])
  editionId      Int?
  edition        GameEdition? @relation(fields: [editionId], references: [id])
  quantity       Int
  price          Int
  activationCode String?
  activated      Boolean      @default(false)
  activatedAt    DateTime?
}
