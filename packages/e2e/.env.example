# URL of the locally running web app (apps/web), e.g. `pnpm dev:web`
E2E_BASE_URL=http://localhost:3000

# URL of the locally running API (apps/api), e.g. `pnpm dev:api`
E2E_API_URL=http://localhost:3500

# Admin account the admin panel E2E tests log in with. The defaults match
# SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD, which `pnpm seed:api` creates.
E2E_ADMIN_EMAIL=seed-admin@dionis-store.local
E2E_ADMIN_PASSWORD=seed-admin-password
