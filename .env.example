# Reference only. Each app reads its own .env file — copy the values below
# into apps/api/.env, apps/web/.env, and packages/e2e/.env as needed.

# apps/api
DATABASE_URL=
ACCESS_TOKEN=
REFRESH_TOKEN=
PORT=
# Web app origin(s) allowed by CORS. Comma-separated for more than one.
CLIENT_URL=http://localhost:3000
SEED_API_URL=http://localhost:3500/api
SEED_ADMIN_NAME=Seed Admin
SEED_ADMIN_EMAIL=seed-admin@dionis-store.local
# Required. Local default only: use a long random value on a public deployment.
SEED_ADMIN_PASSWORD=seed-admin-password
SEED_REVIEWER_PASSWORD=seed-reviewer-password
STRIPE_SECRET_KEY=

# Signing secret for POST /api/orders/webhook. Locally, `stripe listen` prints it
# (whsec_...). Leave empty to run without the webhook: the API still starts.
STRIPE_WEBHOOK_SECRET=

# Set to false when the API is served over plain HTTP (no HTTPS yet). Browsers
# drop a Secure cookie from an HTTP origin, so with the default (true) the
# refresh cookie is lost and the user is logged out on every page load.
# Leave it unset on localhost and on any HTTPS deployment.
COOKIE_SECURE=

# Rate limiting. The API allows 300 requests a minute per client IP, and 10 a
# minute on login, register, and password change. Set RATE_LIMIT=off to turn it
# off (the E2E run does, because its tests sign up many users from one address).
RATE_LIMIT=
# Client IPs that the rate limit skips, separated by commas. Leave it empty to
# limit everyone. Each IP then has no limit on login and register either.
RATE_LIMIT_SKIP_IPS=
# Number of reverse proxies in front of the API: 1 behind Caddy, 0 otherwise.
# Without it every request looks like it comes from the proxy, and one user's
# traffic counts against everyone.
TRUST_PROXY=

# Receipt emails, sent through SMTP. Locally and in CI this is Mailpit
# (`docker compose up mailpit` in apps/api; inbox at http://localhost:8025).
# Leave SMTP_HOST empty to run without email: the API still starts and sends
# nothing. SMTP_USER and SMTP_PASS stay empty for Mailpit.
# On a real SMTP server, receipts for reserved test domains (.test, .local,
# .invalid, .example) are skipped. A local host (localhost, mailpit) gets them.
# Use 127.0.0.1, not localhost: nodemailer looks the name up through the network's
# DNS servers, which can add 20 seconds to the first email.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dionis Store <no-reply@dionis-store.local>

# apps/web
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# packages/e2e
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:3500
# Mailpit HTTP address. The receipt email tests read the inbox from it.
E2E_MAIL_API_URL=http://localhost:8025

# Admin account the admin panel E2E tests log in with. The defaults match
# SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD, which `pnpm seed:api` creates.
E2E_ADMIN_EMAIL=seed-admin@dionis-store.local
E2E_ADMIN_PASSWORD=seed-admin-password

# docker-compose.prod.yml (single-host deploy, read from .env.prod)
# DOMAIN is the public host name, for example shop.example.com. A DNS A record
# must point it to the server. Then set CLIENT_URL and NEXT_PUBLIC_BASE_URL to
# https://<DOMAIN>, because Caddy serves both the web app and /api there.
# ACME_CA is optional: set it to https://acme-staging-v02.api.letsencrypt.org/directory
# for a first test run, and leave it unset for the real certificate.
DOMAIN=
# Also uses ACCESS_TOKEN, REFRESH_TOKEN, CLIENT_URL, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET (optional; STRIPE_SECRET_KEY is required),
# NEXT_PUBLIC_BASE_URL (the public API origin, for example
# http://<server-ip>:3500), NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY, and the SMTP_*
# and MAIL_FROM variables above. Without SMTP_HOST, receipts are not sent.
POSTGRES_PASSWORD=
