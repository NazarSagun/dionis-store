# Reference only. Each app reads its own .env file — copy the values below
# into apps/api/.env, apps/web/.env, and packages/e2e/.env as needed.

# apps/api
DATABASE_URL=
ACCESS_TOKEN=
REFRESH_TOKEN=
PORT=
# Web app origin(s) allowed by CORS. Comma-separated for more than one.
CLIENT_URL=http://localhost:3000
SEED_API_URL=http://localhost:3500/api
SEED_ADMIN_NAME=Seed Admin
SEED_ADMIN_EMAIL=seed-admin@dionis-store.local
SEED_ADMIN_PASSWORD=seed-admin-password
STRIPE_SECRET_KEY=

# Signing secret for POST /api/orders/webhook. Locally, `stripe listen` prints it
# (whsec_...). Leave empty to run without the webhook: the API still starts.
STRIPE_WEBHOOK_SECRET=

# apps/web
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# packages/e2e
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:3500

# Admin account the admin panel E2E tests log in with. The defaults match
# SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD, which `pnpm seed:api` creates.
E2E_ADMIN_EMAIL=seed-admin@dionis-store.local
E2E_ADMIN_PASSWORD=seed-admin-password

# docker-compose.prod.yml (single-host deploy, read from .env.prod)
# Also uses ACCESS_TOKEN, REFRESH_TOKEN, CLIENT_URL, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET (optional; STRIPE_SECRET_KEY is required), NEXT_PUBLIC_BASE_URL (the public API origin, for
# example http://<server-ip>:3500) and NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
POSTGRES_PASSWORD=
